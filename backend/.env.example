# npm start (frontend) reads backend/.env. Copy this file once and fill private values.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/gcmb
DB_USERNAME=gcmb_dev
DB_PASSWORD=
AUTH_SECURE_COOKIE=false

# Optional for login; required to send real recovery email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional if Java is not configured in your system; set an installed JDK 17+ path.
# JAVA_HOME=C:/Program Files/Java/jdk-17
