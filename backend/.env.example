# npm start (frontend) reads backend/.env. Copy this file once and fill private values.
# Optional QLCC business assistant. Keep the key in backend/.env or server environment only.
# Use backend/scripts/setup-gemini.ps1 for hidden key input. For free use, select a Free Tier project without billing.
# Paste only the full copied key value (standard/auth key); local format checks do not verify it with Google.
# The assistant retries provider HTTP 500/502/503/504 once; quota/auth errors are not retried. Logs contain HTTP status only.
# Chat starts with current-month data and a catalog of all recorded periods/branches.
# Gemini can call two allowlisted read-only report tools for any stored period, including full history; no fixed 4-month window.
# Tool queries reuse accounting report definitions and include historical inactive branches. No arbitrary SQL or mutations.
# Browser history is per QLCC account (up to 20 chats/60 messages each), not synced to the server.
# Answers omit internal source codes and the evidence panel; supporting data is listed in natural language only when requested.
# Business analyses weave prioritized decisions and conditions into the answer, without a separate recommendation section or execution.
# AI facts use Vietnamese business labels. A greeting-only answer to a business question is repaired once within the same 45-second deadline.
# Free-tier content may be used by Google to improve products. Use demo/non-sensitive data only.
GCMB_AI_ENABLED=false
GEMINI_API_KEY=
GCMB_AI_MODEL=gemini-3.5-flash-lite

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/gcmb
DB_USERNAME=gcmb_dev
DB_PASSWORD=
AUTH_SECURE_COOKIE=false

# Only for databases that already applied V66 cash notifications and V67 equipment counters.
# Check flyway_schema_history first; the default history has V66 equipment and V67 notifications.
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration-notifications-first

# Optional in dev: npm start can start an existing local cluster. Both values are required.
# Use a JDBC URL on 127.0.0.1 and pg_ctl from the cluster's PostgreSQL major version.
# Relative GCMB_LOCAL_PGDATA paths are resolved from backend/.
# GCMB_LOCAL_PGDATA=target/gcmb-2026-realdata-pgdata
# GCMB_LOCAL_PG_CTL="C:/Program Files/PostgreSQL/18/bin/pg_ctl.exe"

# Optional for login; required to send real recovery email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional if Java is not configured in your system; set an installed JDK 17+ path.
# JAVA_HOME=C:/Program Files/Java/jdk-17

# Checkout transfer: SePay webhook uses Authorization: Apikey <SEPAY_WEBHOOK_KEY>.
# Bank name must match webhook gateway, e.g. Vietcombank or MBBank.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_KEY=


# Author: HuyDV. Private Cloudinary attachments; configure with scripts/setup-cloudinary.ps1.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
