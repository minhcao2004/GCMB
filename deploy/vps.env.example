# Copy to .env at the repository root ON THE VPS. Never commit the real .env.
DB_NAME=gcmb
DB_USERNAME=gcmb
DB_PASSWORD=

# Bootstrap privately using: ssh -L 8088:127.0.0.1:80 USER@VPS_IP
# Open http://localhost:8088 while the SSH connection stays open.
WEB_BIND_IP=127.0.0.1
SITE_ADDRESS=:80
FRONTEND_ORIGIN=http://localhost:8088
AUTH_SECURE_COOKIE=false

# Optional for login; required for password-recovery email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Optional: leave blank to disable SePay transfers until configured.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_KEY=

# Equipment uploads persist in the attachments volume. Some finance/refund
# evidence flows require Cloudinary or S3; see docs/VPS Deployment.md.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GCMB_S3_BUCKET=
GCMB_S3_REGION=us-east-1
GCMB_S3_ENDPOINT=
GCMB_S3_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
